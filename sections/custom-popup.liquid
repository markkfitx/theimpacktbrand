{% if section.settings.enable_popup %}
    <div class="signup-form-wrapper {{ section.settings.content_size_box | default: 'full' }} is-hidden" id="signup-form-wrapper" aria-hidden="true">
        <div class="signup-form-wrapper-content">
            <form id="signup_form" name="signup_form" method="post" action="">
                {% if section.settings.popup_heading != blank or section.settings.popup_heading_two != blank or section.settings.popup_sub_heading != blank %}
                    <div class="signup-form-header">
                        {% if section.settings.popup_heading != blank %}
                            <h1>{{ section.settings.popup_heading }}</h1>
                        {% endif %}
                        {% if section.settings.popup_heading_two != blank %}
                            <h1>{{ section.settings.popup_heading_two }}</h1>
                        {% endif %}
                        {% if section.settings.popup_sub_heading != blank %}
                            <p>{{ section.settings.popup_sub_heading }}</p>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="signup-form-content">
                    <div class="form_input_group row">
                        {% for block in section.blocks %}
                            {% if block.type == 'form_field' and block.settings.show_acknowledgement == false %}
                                {% assign field_id = 'SignupForm-' | append: block.id %}
                                {% assign field_name = block.settings.label | handleize %}
                                <div class="field form_input_group__field" {{ block.shopify_attributes }}>
                                    {% if block.settings.input_type == 'textarea' %}
                                        <textarea
                                            class="field__input"
                                            id="{{ field_id }}"
                                            name="contact[{{ field_name }}]"
                                            placeholder="{{ block.settings.placeholder }}"
                                            {% if block.settings.required %}required aria-required="true"{% endif %}
                                        ></textarea>
                                    {% else %}
                                        <input
                                            class="field__input"
                                            type="{{ block.settings.input_type }}"
                                            id="{{ field_id }}"
                                            name="contact[{{ field_name }}]"
                                            placeholder="{{ block.settings.placeholder }}"
                                            {% if block.settings.required %}required aria-required="true"{% endif %}
                                        >
                                    {% endif %}
                                    {% if block.settings.label != blank %}
                                        <label class="field__label" for="{{ field_id }}">{{ block.settings.label }}</label>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="form_input_checkbox" style="margin-top: 1rem;">
                        {% for block in section.blocks %}
                            {% if block.type == 'form_field' and block.settings.show_acknowledgement %}
                                {% assign ack_id = 'SignupForm-ack-' | append: block.id %}
                                <div class="form_input_checkbox__item" {{ block.shopify_attributes }}>
                                    <input
                                        type="checkbox"
                                        id="{{ ack_id }}"
                                        name="contact[acknowledgement_{{ block.id }}]"
                                        value="true"
                                        {% if block.settings.required %}required aria-required="true"{% endif %}
                                    >
                                    <label for="{{ ack_id }}">
                                        {{ block.settings.acknowledgement_text | default: block.settings.label }}
                                    </label>
                                </div>
                            {% endif %}
                        {% endfor %}
                        {% if section.settings.disclaimer_text != blank %}
                            <p class="signup-form-disclaimer">{{ section.settings.disclaimer_text }}</p>
                        {% endif %}
                    </div>
                </div>
                <div class="signup-form-footer">
                    <button type="submit" class="signup-form__cancel button" name="submit">
                        {{ section.settings.submit_text }}
                    </button>
                    <button type="button" class="signup-form__submit link" name="cancel" id="signup-form-close">
                        {{ section.settings.cancel_text }}
                    </button>
                </div>
            </form>
        </div>
    </div>
    <style>
        .signup-form-header p{
            font-size: 1.65rem;
            font-weight: 400;
            margin: 0.25rem;
        }
        .field__input{
            border: 0.15px solid rgba(255,255,255,0.25);
        }
        .signup-form-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            width: {{ section.settings.content_size_box | default: "full" }};
            background-color: {{ section.settings.background_color }};
            max-width: 100%;
            margin: 0 auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.1);
        }
        .signup-form-wrapper-content{
            width: min(100%, 560px);
            margin: auto;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.1);
        }
        .signup-form-header{
            text-align: center;
            margin-bottom: 2rem;
        }
        .signup-form-header h1{
            font-size: 5rem;
            font-weight: 500;
            margin: 0;
        }
        .form_input_group.row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            width: 100%;
        }
        .form_input_group__field {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            min-width: 0;
        }
        .form_input_group__field:last-child:nth-child(odd) {
            grid-column: 1 / -1;
        }
        .form_input_group__field .field__input {
            width: 100%;
            box-sizing: border-box;
        }
        .signup-form-footer{
            display:flex;
            flex-direction: column;
            gap: 1rem;
            justify-content: center;
            align-items: center;
        }
        .signup-form-footer button{
            width: 100%;
            padding: 1rem;
            border: none;
        }
        .signup-form-disclaimer{
            text-wrap: balance;
            text-align: center;
            margin-top: 3rem;
            margin-bottom: 3rem;
            color: rgba(255,255,255,0.85);
            max-width:540px;
            font-weight: 400 !important;
        }
        .signup-form-disclaimer a{
            color: yellow
        }
        .signup-form-wrapper.is-hidden {
            display: none;
        }
    </style>
    <script>
        (function () {
            const popup = document.getElementById('signup-form-wrapper');
            const form = document.getElementById('signup_form');
            const closeButton = document.getElementById('signup-form-close');

            if (!popup || !form || !closeButton) return;

            function clearFormData() {
                form.reset();

                form.querySelectorAll('input, textarea, select').forEach(function (field) {
                    if (field.type === 'checkbox' || field.type === 'radio') {
                        field.checked = false;
                    } else if (field.type !== 'submit' && field.type !== 'button') {
                        field.value = '';
                    }
                });
            }

            function openPopup() {
                popup.classList.remove('is-hidden');
                popup.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closePopup() {
                clearFormData();
                popup.classList.add('is-hidden');
                popup.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            closeButton.addEventListener('click', closePopup);
            window.openSignupPopup = openPopup;
            window.closeSignupPopup = closePopup;
        })();
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('signup_form');
        
            if (!form) return;
        
            form.addEventListener('submit', async (event) => {
            event.preventDefault();
        
            const firstName = document.getElementById('SignupForm-first_name').value.trim();
            const lastName = document.getElementById('SignupForm-last_name').value.trim();
            const email = document.getElementById('SignupForm-email').value.trim();
            console.log(firstName, lastName, email);
            const PUBLIC_API_KEY = 'St3hS5';
            const LIST_ID = 'SRLhrU';
        
            const payload = {
                data: {
                type: 'subscription',
                attributes: {
                    profile: {
                    data: {
                        type: 'profile',
                        attributes: {
                        email: email,
                        first_name: firstName,
                        last_name: lastName
                        }
                    }
                    }
                },
                relationships: {
                    list: {
                    data: {
                        type: 'list',
                        id: LIST_ID
                    }
                    }
                }
                }
            };
        
            try {
                const response = await fetch(
                `https://a.klaviyo.com/client/subscriptions/?company_id=${PUBLIC_API_KEY}`,
                {
                    method: 'POST',
                    headers: {
                    'Content-Type': 'application/json',
                    'revision': '2024-07-15'
                    },
                    body: JSON.stringify(payload)
                }
                );
        
                if (!response.ok) {
                const error = await response.text();
                throw new Error(error);
                }
        
                console.log('Successfully subscribed to Klaviyo');
        
                form.reset();
        
            } catch (error) {
                console.error('Klaviyo signup failed:', error);
            }
            });
        });
    </script>
{% endif %}


{% schema %}

{
  "name": "Signup Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable signup form",
      "default": false
    },
    {
      "type": "select",
      "id": "content_size_box",
      "label": "Select form size",
      "options": [
        {
          "value": "full",
          "label": "Full Screen"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "small",
          "label": "Small"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Form Header"
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Popup Main Heading",
      "default": "Sign Up Today!"
    },
    {
      "type": "text",
      "id": "popup_heading_two",
      "label": "Popup Heading 2",
      "default": "Lock In Now"
    },
    {
      "type": "text",
      "id": "popup_sub_heading",
      "label": "Popup Sub-Heading",
      "default": "Add your sub heading here"
    },
    {
      "type": "header",
      "content": "Form Configuration"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "cancel_text",
      "label": "Cancel button text",
      "default": "Cancel"
    },
    {
      "type": "header",
      "content": "Legal Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Disclaimer / Release Text",
      "default": "Type Disclaimer here"
    }
    ],
  "blocks": [
    {
        "type": "form_field",
        "name": "Form Field",
        "settings": [
        {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Field label"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "Placeholder",
            "default": "Enter your information"
        },
        {
            "type": "select",
            "id": "input_type",
            "label": "Field type",
            "options": [
            {
                "value": "text",
                "label": "Text"
            },
            {
                "value": "email",
                "label": "Email"
            },
            {
                "value": "tel",
                "label": "Phone"
            },
            {
                "value": "number",
                "label": "Number"
            },
            {
                "value": "textarea",
                "label": "Textarea"
            }
            ],
            "default": "text"
        },
        {
            "type": "checkbox",
            "id": "required",
            "label": "Required field",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_acknowledgement",
            "label": "Show acknowledgement box",
            "default": false
        },
        {
            "type": "text",
            "id": "acknowledgement_text",
            "label": "Acknowledgement text",
            "default": "I acknowledge"
        }
        ]
    }
    ]
}

{% endschema %}