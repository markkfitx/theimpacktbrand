{{ 'section-image-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ImageHero-{{ section.id }} {
    min-height: {{ section.settings.section_height }}vh;
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ImageHero-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  {%- if section.settings.background_image != blank or section.settings.background_image_desktop != blank -%}
    #ImageHero-{{ section.id }} .image-hero__background {
      opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    }
  {%- endif -%}
{%- endstyle -%}

<div
  id="ImageHero-{{ section.id }}"
  class="image-hero color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.background_image != blank or section.settings.background_image_desktop != blank -%}
    <div class="image-hero__background{% if section.settings.background_image == blank and section.settings.background_image_desktop != blank %} image-hero__background--desktop-only{% endif %}">
      {%- if section.settings.background_image != blank -%}
        <img
          src="{{ section.settings.background_image | image_url: width: 3840 }}"
          alt="{{ section.settings.background_image.alt | escape }}"
          class="image-hero__background-image image-hero__background-image--mobile"
          style="object-position: {{ section.settings.image_position | default: 'center' }};"
          loading="lazy"
          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"
        >
      {%- endif -%}
      {%- if section.settings.background_image_desktop != blank -%}
        <img
          src="{{ section.settings.background_image_desktop | image_url: width: 3840 }}"
          alt="{{ section.settings.background_image_desktop.alt | escape }}"
          class="image-hero__background-image image-hero__background-image--desktop"
          style="object-position: {{ section.settings.image_position | default: 'center' }};"
          loading="lazy"
          width="{{ section.settings.background_image_desktop.width }}"
          height="{{ section.settings.background_image_desktop.height }}"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.background_image != blank or section.settings.background_image_desktop != blank -%}
    {%- if section.settings.image_overlay_opacity > 0 -%}
      <div class="image-hero__overlay"></div>
    {%- endif -%}
  {%- endif -%}

  <div class="image-hero__content page-width">
    <div class="image-hero__text-wrapper">
      {%- if section.settings.title != blank -%}
        <h2 class="image-hero__title">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="image-hero__text">
          <p>{{ section.settings.text }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <div class="image-hero__link-wrapper">
          <a
            href="{{ section.settings.link | default: '#' }}"
            class="image-hero__link link{% if section.settings.link_style == 'button' %} button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}{% endif %}"
          >
            {{ section.settings.link_label | escape }}
            {%- unless section.settings.link_style == 'button' -%}
              <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            {%- endunless -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Overrides color scheme background. Leave blank to use color scheme."
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Mobile)",
      "info": "Image displayed on mobile devices. If desktop image is not set, this will be used for all screen sizes."
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Background Image (Desktop)",
      "info": "Optional: Different image for desktop screens (750px and wider). If not set, mobile image will be used."
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Overlay Opacity",
      "default": 30,
      "info": "Adds a dark overlay over the background image for better text readability"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Background Image Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section Size"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section Height",
      "default": 60,
      "info": "Height of the section as a percentage of viewport height"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your Title Here"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Add your supporting paragraph text here to provide more context and information."
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Link Style",
      "options": [
        {
          "value": "text",
          "label": "Text Link"
        },
        {
          "value": "button",
          "label": "Button"
        }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Use secondary button style (outlined)",
      "default": false,
      "info": "Only applies when Link Style is set to Button"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image Hero"
    }
  ]
}
{% endschema %}

