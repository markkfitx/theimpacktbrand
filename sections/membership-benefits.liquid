    },
    {
      "type": "earn_method",
      "name": "Earn Method",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            {
              "value": "dollar",
              "label": "Dollar Sign"
            },
            {
              "value": "user",
              "label": "User/Account"
            },
            {
              "value": "birthday",
              "label": "Birthday Cake"
            },
            {
              "value": "chat",
              "label": "Chat/Connect"
