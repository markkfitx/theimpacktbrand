      "label": "Show Ways to Earn section",
      "default": true
    },
    {
      "type": "text",
      "id": "ways_to_earn_title",
      "label": "Ways to Earn Title",
      "default": "WAYS TO EARN"
    },
    {
      "type": "header",
      "content": "How to Use Points Section"
    },
    {
      "type": "checkbox",
      "id": "show_how_to_use_points",
      "label": "Show How to Use Points section",
      "default": true
    },
    {
      "type": "text",
      "id": "how_to_use_points_title",
      "label": "How to Use Points Title",
      "default": "HOW TO USE YOUR POINTS"
    },
    {
      "type": "text",
      "id": "how_to_use_points_subtitle",
      "label": "How to Use Points Subtitle",
      "default": "Redeeming your points is easy! Just log in, and choose an eligible reward at checkout."
    },
    {
      "type": "header",
      "content": "Member Status Section"
