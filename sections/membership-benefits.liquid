            },
            {
              "value": "custom",
              "label": "Custom SVG"
            }
          ],
          "default": "dollar"
        },
        {
          "type": "html",
          "id": "icon",
          "label": "Custom Icon (SVG HTML)",
          "info": "Only used if 'Custom SVG' is selected above"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "EARN WHILE YOU SHOP"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "1 point for every $1 spent"
        }
      ]
    },
    {
      "type": "reward",
