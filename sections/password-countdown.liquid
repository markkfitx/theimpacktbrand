{{ 'section-password-countdown.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

<script>
  document.body.classList.add('has-password-countdown');
</script>

{%- style -%}
  .password-countdown-{{ section.id }} {
    background: linear-gradient(135deg, #131313 0%,rgb(8, 10, 29) 50%, #343434 100%);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }
  
  {%- if section.settings.background_image != blank -%}
    .password-countdown-{{ section.id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      opacity: 0.2;
      z-index: 0;
    }
  {%- endif -%}
{%- endstyle -%}

<div class="password-countdown password-countdown-{{ section.id }}">
  <div class="password-countdown__container">
    <!-- Navigation Bar -->
    <nav class="password-countdown__nav">
      <div class="password-countdown__nav-logo">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
          {{
            section.settings.logo
            | image_url: width: 100
            | image_tag:
              class: 'password-countdown__logo-img',
              widths: '50, 100, 150',
              width: section.settings.logo_width,
              height: logo_height,
              alt: logo_alt
          }}
        {%- else -%}
          <span class="password-countdown__logo-text" style="text-wrap:nowrap;">{{ shop.name }}</span>
        {%- endif -%}
      </div>
      
      <div class="password-countdown__nav-links">
        {%- if section.settings.nav_link_1 != blank -%}
          <a href="{{ section.settings.nav_link_1 }}" class="password-countdown__nav-link{% if section.settings.nav_link_1_active %} active{% endif %}">{{ section.settings.nav_link_1_text }}</a>
        {%- endif -%}
        {%- if section.settings.nav_link_2 != blank -%}
          <a href="{{ section.settings.nav_link_2 }}" class="password-countdown__nav-link{% if section.settings.nav_link_2_active %} active{% endif %}">{{ section.settings.nav_link_2_text }}</a>
        {%- endif -%}
        {%- if section.settings.nav_link_3 != blank -%}
          <a href="{{ section.settings.nav_link_3 }}" class="password-countdown__nav-link{% if section.settings.nav_link_3_active %} active{% endif %}">{{ section.settings.nav_link_3_text }}</a>
        {%- endif -%}
      </div>
      
      <div class="password-countdown__nav-actions">
        <button class="password-countdown__search-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.5 11H11.71L11.43 10.73C12.41 9.59 13 8.11 13 6.5C13 2.91 10.09 0 6.5 0C2.91 0 0 2.91 0 6.5C0 10.09 2.91 13 6.5 13C8.11 13 9.59 12.41 10.73 11.43L11 11.71V12.5L16 17.49L17.49 16L12.5 11ZM6.5 11C4.01 11 2 8.99 2 6.5C2 4.01 4.01 2 6.5 2C8.99 2 11 4.01 11 6.5C11 8.99 8.99 11 6.5 11Z" fill="white"/>
          </svg>
        </button>
        <button class="password-countdown__login-btn" data-open-password-modal onclick="document.querySelector('[data-password-modal]')?.setAttribute('open', '')" aria-label="{{ 'general.password_page.login_password_button' | t }}">
          <span class="svg-wrapper">
            {{- 'icon-padlock.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="password-countdown__content">
      <div class="password-countdown__text-content">
        {%- if section.settings.heading != blank -%}
          <h1 class="password-countdown__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        
        {%- if section.settings.pre_order_text != blank -%}
          <p class="password-countdown__pre-order">{{ section.settings.pre_order_text }}</p>
        {%- endif -%}
        
        <!-- Countdown Timer -->
        <div class="password-countdown__timer" data-countdown-date="{{ section.settings.countdown_date }}">
          <div class="password-countdown__timer-item">
            <span class="password-countdown__timer-number" data-days>00</span>
            <span class="password-countdown__timer-label">DAYS</span>
          </div>
          <div class="password-countdown__timer-item">
            <span class="password-countdown__timer-number" data-hours>00</span>
            <span class="password-countdown__timer-label">HOURS</span>
          </div>
          <div class="password-countdown__timer-item">
            <span class="password-countdown__timer-number" data-minutes>00</span>
            <span class="password-countdown__timer-label">MINUTES</span>
          </div>
          <div class="password-countdown__timer-item">
            <span class="password-countdown__timer-number" data-seconds>00</span>
            <span class="password-countdown__timer-label">SECONDS</span>
          </div>
        </div>
        
        {%- if section.settings.watch_link_text != blank and section.settings.watch_link_url != blank -%}
          <a href="{{ section.settings.watch_link_url }}" class="password-countdown__watch-link">
            {{ section.settings.watch_link_text }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 12L4 8L5.41 6.59L8 9.17L10.59 6.59L12 8L8 12Z" fill="white"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
      
      {%- if section.settings.product_image != blank -%}
        <div class="password-countdown__image-wrapper">
          {{
            section.settings.product_image
            | image_url: width: 800
            | image_tag:
              class: 'password-countdown__product-image',
              widths: '400, 600, 800, 1000',
              loading: 'lazy',
              alt: section.settings.product_image.alt | default: section.settings.heading
          }}
        </div>
      {%- endif -%}
    </div>

    <!-- Social Media Icons -->
    {%- liquid
      assign has_social_icons = false
      if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
        assign has_social_icons = true
      endif
    -%}
    {%- if section.settings.show_social_icons and has_social_icons -%}
      <div class="password-countdown__social">
        <ul class="list-social list-unstyled password-countdown__social-list" role="list">
        {%- if settings.social_twitter_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_twitter_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-twitter.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_facebook_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-facebook.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_pinterest_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-pinterest.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_instagram_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-instagram.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_tiktok_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-tiktok.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_tumblr_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_tumblr_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-tumblr.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_snapchat_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_snapchat_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-snapchat.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_youtube_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-youtube.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_vimeo_link != blank -%}
          <li class="list-social__item">
            <a href="{{ settings.social_vimeo_link }}" class="link list-social__link password-countdown__social-link" target="_blank" rel="noopener">
              <span class="svg-wrapper">
                {{- 'icon-vimeo.svg' | inline_asset_content -}}
              </span>
              <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
            </a>
          </li>
        {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- Password Popup Modal -->
<password-modal>
  <details class="password-popup-modal modal" {% if form.errors %}open{% endif %} data-password-modal>
    <summary class="visually-hidden" aria-haspopup="dialog">Open password modal</summary>
    <div class="password-popup-modal__overlay" role="dialog" aria-labelledby="PasswordModalHeading" aria-modal="true">
      <div class="password-popup-modal__content">
        <p class="password-popup-modal__prompt">Enter store using password:</p>
        <div class="password-popup-modal__form-wrapper">
          {%- form 'storefront_password', class: 'password-popup-form' -%}
            <div class="password-popup-field{% if form.errors %} password-popup-field--error{% endif %}">
              <input
                type="password"
                name="password"
                id="PasswordPopup"
                class="password-popup-input"
                autocomplete="current-password"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordPopupForm-password-error"
                {%- endif -%}
                placeholder="Your password"
                autofocus
              >
              <button type="submit" name="commit" class="password-popup-button">
                Enter
              </button>
              {%- if form.errors -%}
                <div id="PasswordPopupForm-password-error" class="password-popup-error" role="status">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="password-popup-error-message">
                    {{ 'general.password_page.login_form_error' | t }}
                  </span>
                </div>
              {%- endif -%}
            </div>
          {%- endform -%}
          <button type="button" class="password-popup-close" aria-label="{{ 'accessibility.close' | t }}" data-close-modal>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 4L4 12M4 4L12 12" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <p class="password-popup-modal__footer">
          Are you the store owner? <a href="/admin" class="password-popup-modal__admin-link">Log in here</a>
        </p>
      </div>
    </div>
  </details>
</password-modal>

<script src="{{ 'password-countdown.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Password Countdown",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "nav_link_1_text",
      "label": "Navigation Link 1 Text",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "nav_link_1",
      "label": "Navigation Link 1 URL"
    },
    {
      "type": "checkbox",
      "id": "nav_link_1_active",
      "label": "Mark Link 1 as Active",
      "default": false
    },
    {
      "type": "text",
      "id": "nav_link_2_text",
      "label": "Navigation Link 2 Text",
      "default": "About"
    },
    {
      "type": "url",
      "id": "nav_link_2",
      "label": "Navigation Link 2 URL"
    },
    {
      "type": "checkbox",
      "id": "nav_link_2_active",
      "label": "Mark Link 2 as Active",
      "default": false
    },
    {
      "type": "text",
      "id": "nav_link_3_text",
      "label": "Navigation Link 3 Text",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "nav_link_3",
      "label": "Navigation Link 3 URL"
    },
    {
      "type": "checkbox",
      "id": "nav_link_3_active",
      "label": "Mark Link 3 as Active",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "text",
      "id": "pre_order_text",
      "label": "Pre-order Text",
      "default": "PRE-ORDER"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown Date",
      "info": "Format: YYYY-MM-DD HH:MM:SS (e.g., 2024-12-31 23:59:59)",
      "default": "2024-12-31 23:59:59"
    },
    {
      "type": "text",
      "id": "watch_link_text",
      "label": "Watch Link Text",
      "default": "Watch the keynote"
    },
    {
      "type": "url",
      "id": "watch_link_url",
      "label": "Watch Link URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Optional background image (will be overlaid with gradient)"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Product image to display in the countdown section"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show Social Media Icons",
      "default": true,
      "info": "Display social media icons at the bottom of the page. Social media links are configured in Theme Settings > Social Media."
    }
  ]
}
{% endschema %}

