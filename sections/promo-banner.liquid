{{ 'section-promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<script>
  window._klOnsite = window._klOnsite || [];
</script>

{%- style -%}
  #PromoBanner-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PromoBanner-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign show_mobile_slider = false
  if section.blocks.size > 1
    assign show_mobile_slider = true
  endif
-%}

<div
  id="PromoBanner-{{ section.id }}"
  class="promo-banner promo-banner--animated color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="page-width">
    <slider-component class="slider-mobile-gutter">
      <ul
        class="promo-banner__list{% if show_mobile_slider %} promo-banner__list--slider slider slider--mobile grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="promo-banner__item{% if show_mobile_slider %} slider__slide{% endif %}"
            style="--promo-stagger: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="promo-banner__link{% if forloop.index == 1 %} promo-banner__link--klaviyo-trigger{% endif %}"
                  {% if forloop.index == 1 %}data-klaviyo-form="WdX36K"{% endif %}
                >
                  <span class="promo-banner__card">
                    <span class="promo-banner__heading-wrap">
                      <span class="promo-banner__heading">{{ block.settings.heading | escape }}</span>
                    </span>
                    {%- if block.settings.link_label != blank -%}
                      <span class="promo-banner__link-label">
                        <span class="promo-banner__link-label-text">{{ block.settings.link_label | escape }}</span>
                      </span>
                    {%- endif -%}
                  </span>
                </a>
              {%- else -%}
                <div class="promo-banner__content promo-banner__card">
                  <span class="promo-banner__heading-wrap">
                    <span class="promo-banner__heading">{{ block.settings.heading | escape }}</span>
                  </span>
                  {%- if block.settings.link_label != blank -%}
                    <span class="promo-banner__link-label promo-banner__link-label--static">
                      <span class="promo-banner__link-label-text">{{ block.settings.link_label | escape }}</span>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('PromoBanner-{{ section.id }}');
    if (!root) return;

    var klaviyoTrigger = root.querySelector('.promo-banner__link--klaviyo-trigger');
    if (klaviyoTrigger) {
      klaviyoTrigger.addEventListener('click', function (e) {
        var formId = this.getAttribute('data-klaviyo-form');
        if (formId && window._klOnsite) {
          e.preventDefault();
          window._klOnsite.push(['openForm', formId]);
        }
      });
    }

    var list = root.querySelector('.promo-banner__list--slider');
    if (!list || list.children.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(min-width: 750px)').matches) return;

    var index = 0;
    var intervalMs = 5500;

    setInterval(function () {
      if (list.matches(':hover')) return;
      index = (index + 1) % list.children.length;
      list.children[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }, intervalMs);
  });
</script>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Overrides color scheme background. Leave blank to use color scheme."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Message",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "PROMO MESSAGE"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Shop Now",
          "info": "Optional label shown below the heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "heading": "$25 BONUS WHEN YOU SPEND $125",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "FREE SHIPPING ON EVERYTHING",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "50% OFF DOORBUSTERS",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "2X POINTS ON GIFT CARDS",
            "link_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
